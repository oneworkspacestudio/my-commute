Page Dashboard
  Row variant=topbar
    Row gap=sm
      Image src="./commute.svg" alt="" width=38 height=38
      Stack gap=none
        Text variant=brand "My Commute"
        Text variant=eyebrow "LONDON, CONNECTED"
    Row gap=sm
      Badge tone=neutral "London $time"
      Link href="/" variant=apps "Apps"
  Row variant=workspace
    Section variant=sidebar
      Text variant=eyebrow "YOUR EVERYDAY, SIMPLIFIED"
      Button variant=$todayVariant intent=today icon=route "Your journey"
      Button variant=$boardVariant intent=board icon=clock "Live departures"
      Button variant=$statusVariant intent=status icon=activity "Network status"
      Button variant=$savedVariant intent=saved icon=bookmark "Saved journeys"
      Spacer
      Card variant=sidebar-note
        Icon name=map-pin
        Heading level=3 "Made for London."
        Text "Bus, Tube and rail. One connected journey."
      Button variant=$settingsVariant intent=settings icon=settings "Preferences"
    Stack variant=main
      If condition=$error
        Alert tone=warning role=alert "$error"
      If condition=$loading
        Alert tone=info "Connecting to your Workspace account…"
      If condition=$signedOut
        Card variant=welcome
          Heading level=1 "Your London. Your way."
          Text "Sign in with MyAccounts to save your journeys and connect your live buses, Tube and trains."
          If condition=$localLogin
            Text variant=muted "$localLoginDescription"
            Input name=email value=$email type=email label="Email" autoComplete=username
            Input name=password value=$password type=password label="Password" autoComplete=current-password
            Button intent=login variant=primary "$localLoginLabel"
          Else
            Link href=$loginURL variant=primary "Sign in with MyAccounts"
      Else
        If condition=$showPageHeading
          Row variant=page-heading
            Stack gap=sm
              Text variant=eyebrow "$date · LONDON"
              Heading level=1 "$title"
              Text variant=muted "$subtitle"
            Button intent=refresh variant=quiet icon=refresh disabled=$busy "$refreshLabel"
        If condition=$showJourney
          Stack variant=journey-overview
            Row variant=direction-controls
              Row variant=segmented
                Button intent=outbound variant=$outboundVariant pressed=$outboundActive icon=briefcase "To work"
                Button intent=inbound variant=$inboundVariant pressed=$inboundActive icon=home "Going home"
              Button intent=refresh variant=journey-refresh label=$refreshLabel icon=refresh disabled=$busy
            If condition=$emptyDirection
              Card variant=welcome
                Heading level=1 "Set up this direction"
                Text "Add the stops and services you use, in travel order."
                Button intent=edit variant=primary icon=plus "Edit journey"
            Else
              Card variant=hero
                Row variant=spread
                  If condition=$heroBadge
                    Badge tone=mint "$heroBadge"
                  If condition=$example
                    Text variant=hero-foot "Example journey"
                Heading level=1 "$heroTitle"
                If condition=$heroCopy
                  Text variant=hero-copy "$heroCopy"
                If condition=$hasRecommendation
                  Row variant=hero-stats
                    Stack gap=xs
                      Text variant=stat-label "$arriveLabel"
                      Text variant=stat-value "$arriveBy"
                    Stack gap=xs
                      Text variant=stat-label "$waitLabel"
                      Text variant=stat-value "$platformWait"
                      If condition=$waitStop
                        Text variant=hero-foot "$waitStop"
              Card variant=trip-quick
                Row variant=spread
                  Heading level=2 "$nextTitle"
                  If condition=$showConnectionPlan
                    Badge tone=$feedTone "$feedLabel"
                If condition=$tripProgress
                  Text variant=connection "$tripProgress"
                If condition=$showConnectionPlan
                  Text variant=muted "$firstStop"
                  If condition=$hasNextArrivals
                    Stack variant=catchable-list gap=none
                      Row variant=departure-columns
                        Text "Departure"
                        Text "$deadlineLabel"
                      For each=$nextArrivals
                        Row variant=$item.variant
                          Stack gap=xs
                            Text variant=strong "$item.clock · $item.service"
                            Text variant=muted "$item.detail"
                          Text variant=departure-deadline "$item.deadline"
                  If condition=$feedFreshness
                    Text variant=muted "$feedFreshness"
                  If condition=$feedIssue
                    Text variant=muted "$feedIssue"
                  Row variant=trip-actions gap=sm
                    Button intent=boardLeg variant=primary "$boardLegLabel"
                    Button intent=board variant=quiet "See all departures"
                If condition=$canUndoBoarding
                  Row variant=trip-actions gap=sm
                    Button intent=undoBoarding variant=quiet "Undo boarding"
                    Button intent=restartTrip variant=quiet "Restart journey"
          If condition=$hasJourneyChoices
            Row variant=journey-controls
              Select name=journey value=$journeyId options=$journeyOptions label="Saved journey"
          If condition=$example
            Alert tone=info "Example journey · Real TfL arrivals, with illustrative walking and ride times. Add your own commute to personalise it."
          Row variant=location-strip
            Icon name=map-pin
            Text "$locationLabel"
            If condition=$canUseLocation
              Button intent=locate variant=text "$locationButton"
          If condition=$hasJourneyLegs
            Grid variant=journey-grid
              Stack gap=lg
                Card variant=timeline
                  Row variant=spread
                    Heading level=2 "Journey details"
                    Button intent=edit variant=text icon=pencil "Edit"
                  For each=$steps
                    Row variant=step
                      Icon name=$item.icon tone=$item.tone
                      Stack gap=sm
                        Text variant=eyebrow "$item.walkLabel"
                        Row variant=spread
                          Heading level=3 "$item.title"
                          Badge tone=$item.tone "$item.time"
                        Text variant=muted "$item.detail"
                        Text variant=connection "$item.connection"
                        If condition=$item.showStart
                          Button intent=startHere payload=$item.index variant=text "Start from this stop"
                  Row variant=destination
                    Icon name=flag
                    Stack gap=xs
                      Text variant=strong "$destination"
                      Text variant=muted "$finalWalkLabel"
              Stack gap=lg
                Card variant=insight
                  Heading level=3 "Boarding buffer"
                  Text "$bufferNote"
                  Button intent=settings variant=text "Adjust your preferences"
        If condition=$showBoard
          If condition=$example
            Alert tone=info "Example journey · Real TfL arrivals, with illustrative walking and ride times. Add your own commute to personalise it."
          Row variant=journey-controls
            Select name=journey value=$journeyId options=$journeyOptions label="Saved journey"
            Row variant=segmented
              Button intent=outbound variant=$outboundVariant pressed=$outboundActive "To work"
              Button intent=inbound variant=$inboundVariant pressed=$inboundActive "Going home"
          If condition=$hasBusLegs
            Row variant=segmented
              Button intent=showArrivals variant=$arrivalsVariant "Arrivals"
              Button intent=showTimetables variant=$timetablesVariant "Bus timetables"
          If condition=$showUpcoming
            Stack gap=lg
              For each=$boards
                Card variant=board
                  Row variant=spread
                    Stack gap=sm
                      Text variant=eyebrow "$item.label"
                      Heading level=2 "$item.name"
                    Badge tone=$item.tone "$item.state"
                  Text variant=muted "$item.filter"
                  If condition=$item.freshness
                    Text variant=muted "$item.freshness"
                  For each=$item.rows
                    Row variant=arrival
                      Badge tone=$item.tone "$item.line"
                      Stack gap=xs
                        Text variant=strong "$item.destination"
                        Text variant=muted "$item.detail"
                      Stack variant=arrival-time
                        Text variant=countdown "$item.minutes"
                        Text variant=muted "$item.clock"
                  Text variant=muted "$item.message"
          If condition=$emptyTimetables
            Card
              Heading level=2 "Bus timetable unavailable"
              Text "Choose a journey with bus legs. If a timetable could not be loaded, refresh to retry. Live arrivals work independently."
          If condition=$showTimetables
            Card variant=timetable-filter
              Heading level=2 "Full-day bus timetables"
              Text variant=muted "Published times in London local time. Use Arrivals for live updates. A time like 24:10 means 00:10 the following day."
              Select name=timetableDay value=$timetableDay options=$timetableOptions label="Bus timetable day pattern"
            For each=$timetableCards
              Card variant=timetable
                Row variant=timetable-header gap=sm
                  Badge tone=red "$item.line"
                  Heading level=3 "$item.stop"
                If condition=$item.warning
                  Text variant=muted "$item.warning"
                If condition=$item.empty
                  Text "No confirmed pattern selected for this route. Choose a published day pattern above."
                For each=$item.patterns
                  Stack gap=md
                    Badge tone=neutral "$item.name"
                    If condition=$item.hasFrequency
                      Stack variant=timetable-frequency gap=sm
                        Text variant=strong "Service frequency"
                        For each=$item.frequencies
                          Row variant=frequency-window gap=sm
                            If condition=$item.window
                              Text variant=strong "$item.window"
                            Text "$item.detail"
                    If condition=$item.hasDepartures
                      Stack gap=sm
                        Text variant=eyebrow "SCHEDULED DEPARTURES"
                        For each=$item.groups
                          Stack variant=timetable-destination gap=xs
                            Heading level=4 "$item.heading"
                            For each=$item.rows
                              Row variant=timetable-hour gap=sm
                                Text variant=timetable-hour "$item.hour"
                                Row variant=timetable-times gap=xs
                                  For each=$item.times
                                    Text variant=timetable-time "$item.text"
        If condition=$showStatus
          Text variant=muted "Live TfL line status, including disruption details."
          For each=$statuses
            Card variant=status-card
              Row variant=spread
                Row gap=md
                  Icon name=train tone=$item.tone
                  Heading level=3 "$item.name"
                Badge tone=$item.tone "$item.status"
              Text variant=muted "$item.reason"
          If condition=$noStatus
            Card
              Text "$statusMessage"
        If condition=$showSaved
          Button intent=new variant=primary icon=plus "Add a journey"
          FileInput label="Import prepared journey"
          If condition=$noSaved
            Card variant=welcome
              Icon name=bookmark
              Heading level=2 "Make the everyday easier"
              Text "Save your commute once. Get the buses and trains you can catch, every day."
          For each=$savedJourneys
            Card
              Row variant=spread
                Stack gap=sm
                  Heading level=2 "$item.name"
                  Text variant=muted "$item.description"
                Button intent=openJourney payload=$item.id variant=primary "Open"
              Row gap=sm
                Button intent=editJourney payload=$item.id variant=text icon=pencil "Edit journey"
                Button intent=deleteJourney payload=$item.id variant=danger icon=trash "Delete"
        If condition=$showSettings
          Card variant=settings
            Heading level=2 "Travel at your pace"
            Text variant=muted "Used to choose connections you can realistically make. All durations are in minutes."
            Input name=buffer type=number min=1 max=15 value=$buffer label="Boarding safety buffer"
            Select name=walkSpeed value=$walkSpeed label="Walking pace" options=$walkOptions
            Input name=finalWalk type=number min=0 max=60 value=$finalWalk label="Walk from your last stop to your destination"
            Button intent=savePreferences variant=primary "Save preferences"
          Card
            Heading level=2 "Your data & location"
            Text "Journeys and the Home or Work points you choose are saved privately to your Workspace account. Use my location checks where you are now and expires after two minutes."
            Text "$railAvailability"
            Link href="https://tfl.gov.uk" target="_blank" "Powered by Transport for London open data"
            Link href="https://www.nationalrail.co.uk/developers/darwin-data-feeds/" target="_blank" "National Rail Darwin information"
            Button intent=logout variant=text "Sign out"
          If condition=$isOwner
            Card variant=settings
              Heading level=2 "Connect transport data"
              Text variant=muted "TfL works without a key within its public limits. Add your credentials to enable National Rail or your TfL subscription. Existing keys stay unchanged when left blank."
              Input name=providerKey value=$providerKey type=password label="TfL API key (optional)" autoComplete=off
              Input name=providerRail value=$providerRail type=password label="National Rail Darwin token" autoComplete=off
              Button intent=saveProviders variant=primary "Save data connections"
        If condition=$showEditor
          Card variant=editor
            If condition=$showLegList
              Stack gap=lg
                Row variant=spread
                  Heading level=2 "$editorTitle"
                  Button intent=cancelEdit variant=quiet "Cancel"
                Input name=journeyName value=$editName label="Journey name" placeholder="My work commute" maxLength=80
                Row variant=segmented
                  Button intent=editOutbound variant=$editOutboundVariant disabled=$reverseBusy icon=briefcase "To work"
                  Button intent=editInbound variant=$editInboundVariant disabled=$reverseBusy icon=home "Going home"
                If condition=$canReverse
                  Button intent=reverseReturn variant=quiet disabled=$reverseBusy "Reverse To work journey"
                If condition=$reverseBusy
                  Alert tone=info role=status "Checking return stops and services…"
                If condition=$needsReturnSetup
                  Alert tone=warning "Open Going home and finish any legs marked Needs setup before saving."
                If condition=$showEditControls
                  Stack variant=origin-card gap=sm
                    Row variant=leg-actions gap=sm
                      Text variant=strong "Starting point · $editOriginName"
                      Button intent=toggleOrigin variant=quiet "$originAction"
                    Text variant=muted "$originDescription"
                    If condition=$originOpen
                      Stack gap=sm
                        Input name=originPostcode value=$originPostcode label=$originPostcodeLabel placeholder="Enter a UK postcode" maxLength=9 autoComplete=off disabled=$originBusy
                        Row variant=leg-actions gap=sm
                          Button intent=originLookup variant=quiet disabled=$postcodeDisabled "Use postcode"
                          Button intent=originLocate variant=quiet disabled=$originBusy "Use current location"
                          If condition=$hasEditOrigin
                            Button intent=removeOrigin variant=danger "Remove starting point"
                        Text variant=muted "Postcode lookup sends just the postcode to Postcodes.io. It gives an approximate point for the area. Use your device location to pin a specific spot."
                        If condition=$originBusy
                          Text role=status variant=muted "Finding starting point…"
                  Text variant=muted "Add one leg at a time. Use Move up or Move down to change the travel order."
                  For each=$editLegs
                    Stack variant=leg-card gap=sm
                      Row gap=sm
                        Icon name=$item.icon
                        Stack gap=xs
                          Text variant=strong "$item.title"
                          Text variant=muted "$item.detail"
                      Row variant=leg-actions gap=sm
                        Button intent=moveLegUp payload=$item.id variant=quiet disabled=$item.first "Move up"
                        Button intent=moveLegDown payload=$item.id variant=quiet disabled=$item.last "Move down"
                        Button intent=editLeg payload=$item.id variant=quiet "$item.editLabel"
                        Button intent=removeLeg payload=$item.id variant=danger "Remove"
                  Button intent=startLeg variant=wide icon=plus "Add a leg"
                  Row variant=editor-footer
                    Text variant=muted "$editorSummary"
                    Button intent=saveJourney variant=primary disabled=$saving "Save journey"
            If condition=$buildingLeg
              Stack gap=lg
                Row variant=spread
                  Heading level=2 "$builder.title"
                  Button intent=cancelLeg variant=quiet "Cancel leg"
                If condition=$builder.showMode
                  Grid variant=form-grid
                    Button intent=chooseBus variant=transport-choice icon=bus "Bus"
                    Button intent=chooseTrain variant=transport-choice icon=train "Train"
                If condition=$builder.showTrain
                  Stack gap=sm
                    For each=$builder.trainModes
                      Button intent=chooseTrainMode payload=$item.id variant=search-result icon=train "$item.label"
                If condition=$builder.showSearch
                  Stack gap=sm
                    Input name=builderSearch value=$builder.query label=$builder.searchLabel placeholder="Type a stop or station name" maxLength=100 autoComplete=off
                    For each=$builder.searchResults
                      Button intent=builderStop payload=$item.id variant=search-result disabled=$builder.busy "$item.label"
                If condition=$builder.showServices
                  Stack gap=sm
                    Text variant=strong "$builder.stopName"
                    If condition=$builder.hasServices
                      Stack gap=sm
                        Input name=builderSearch value=$builder.query label=$builder.serviceLabel placeholder="Type to filter" autoComplete=off
                        Services name=builderServices value=$builder.selectedServices label="Services I can take" options=$builder.serviceOptions disabled=$builder.busy
                    Button intent=builderContinue variant=primary disabled=$builder.cannotContinue "Choose where to get off"
                If condition=$builder.showAlight
                  Stack gap=sm
                    If condition=$builder.noCommonStop
                      Text "These services have no shared downstream stop. Go back and change the selection."
                    If condition=$builder.rail
                      Text variant=muted "Select the station where you leave the train."
                    Else
                      Stack gap=sm
                        Input name=builderSearch value=$builder.query label="Search stops to get off at" placeholder="Type a stop name" autoComplete=off
                        For each=$builder.alightOptions
                          Button intent=builderAlight payload=$item.id variant=search-result "$item.label"
                If condition=$builder.showReview
                  Stack gap=sm
                    Text variant=strong "$builder.summary"
                    If condition=$builder.destinations
                      Text variant=muted "Towards $builder.destinations"
                    If condition=$builder.rail
                      Stack gap=sm
                        Input name=builderCrs value=$builder.crs label="Boarding station code (CRS)" placeholder="e.g. WAT" maxLength=3
                        Input name=builderToCrs value=$builder.toCrs label="Alighting station code (CRS)" placeholder="e.g. CLJ" maxLength=3
                    Alert tone=info "$builder.estimate"
                    Button intent=builderChangeRoute variant=quiet "Change stops and services"
                    Button intent=builderOptions variant=quiet "$builder.optionsLabel"
                    If condition=$builder.optionsOpen
                      Stack gap=sm
                        Input name=builderWalk value=$builder.walk type=number min=0 max=90 label="Walk to boarding (minutes)"
                        Button intent=builderOverride variant=quiet "$builder.overrideLabel"
                        If condition=$builder.override
                          Input name=builderRide value=$builder.ride type=number min=1 max=180 label="Ride duration override (minutes)"
                    Button intent=addLeg variant=primary disabled=$builder.busy "$builder.addLabel"
                If condition=$builder.busy
                  Text role=status variant=muted "Loading transport data…"
                If condition=$builder.notice
                  Alert tone=warning role=status "$builder.notice"
                If condition=$builder.showBack
                  Button intent=builderBack variant=quiet "Back"
        Row variant=footer
          Text "My Commute · London"
          Text "Departures refresh about once a minute while open."
  Row variant=bottom-nav
    Button intent=today variant=$todayVariant icon=route "Journey"
    Button intent=board variant=$boardVariant icon=clock "Live"
    Button intent=status variant=$statusVariant icon=activity "Status"
    Button intent=saved variant=$savedVariant icon=bookmark "Saved"
    Button intent=settings variant=$settingsVariant icon=settings "You"
  If condition=$toast
    Alert variant=toast role=status "$toast"
